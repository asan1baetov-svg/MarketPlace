<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>greenecomall</groupId>
	<artifactId>green-eco-mall</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>green-eco-mall</name>
	<description>Мультивендорный маркетплейс «Грин Эко Молл» — монорепозиторий</description>

	<properties>
		<java.version>21</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

	<modules>
		<module>common/common-domain</module>
		<module>common/common-events</module>
		<module>common/common-security</module>
		<module>common/common-web</module>
		<module>common/common-test</module>
		<module>services/auth-service</module>
		<module>services/catalog-service</module>
		<module>services/order-service</module>
		<module>services/finance-service</module>
		<module>services/courier-service</module>
		<module>services/mlm-service</module>
		<module>services/notification-service</module>
		<module>services/api-gateway</module>
	</modules>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>greenecomall</groupId>
				<artifactId>common-domain</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>greenecomall</groupId>
				<artifactId>common-events</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>greenecomall</groupId>
				<artifactId>common-security</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>greenecomall</groupId>
				<artifactId>common-web</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>greenecomall</groupId>
				<artifactId>common-test</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>1.20.4</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

</project>
